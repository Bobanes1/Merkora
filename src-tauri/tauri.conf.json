{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Merkora",
  "version": "0.8.6",
  "identifier": "app.merkora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Lernen mit Karteikarten, Lernpfad und KI",
    "longDescription": "Merkora – Karteikarten mit verteiltem Wiederholen, Anki-Import, Lernpfad, Quiz, Zusammenfassungen und KI-Tutor.",
    "copyright": "Merkora",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "apkg",
          "colpkg"
        ],
        "name": "Anki-Stapel",
        "description": "Anki-Stapelpaket",
        "role": "Viewer",
        "mimeType": "application/x-anki-package"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ]
      }
    },
    "linux": {
      "deb": {
        "section": "education"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBMjEzMDVBQjBCMzhFQkUKUldTK2pyT3dXakFoNnZRWDFiYWlFV1lpcWI3aUtGNk0yZWd3NVRwb0hSRnM0c1k1TlRtWkMwNmYK",
      "endpoints": [
        "https://github.com/Bobanes1/Merkora/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

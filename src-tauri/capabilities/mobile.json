{
  "identifier": "mobile",
  "description": "Merkora on Android: the same window without the desktop-only parts (updates, autostart, window size)",
  "windows": [
    "main"
  ],
  "platforms": [
    "android",
    "iOS"
  ],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-load-data",
    "allow-save-data",
    "allow-save-data-now",
    "allow-data-folder",
    "allow-open-external",
    "allow-media-put",
    "allow-media-get",
    "allow-media-get-b64",
    "allow-media-type",
    "allow-media-keys",
    "allow-media-delete",
    "allow-import-apkg",
    "allow-import-apkg-path",
    "allow-take-open-files",
    "allow-http-fetch",
    "allow-smoke-info",
    "allow-smoke-done",
    "allow-save-download",
    "allow-export-apkg",
    "notification:default",
    "dialog:allow-open",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "allow-finish-close",
    "allow-set-tray-mode",
    "allow-get-backup-dir",
    "allow-list-backups",
    "allow-read-backup",
    "allow-backup-now",
    "allow-download-apk",
    "allow-open-media-file",
    "allow-run-java",
    "allow-java-available"
  ]
}
